# Local development.

# Where the Vite dev server proxies /api requests.
# Read by vite.config.js via loadEnv(). No VITE_ prefix on purpose, so it
# stays a build-time setting and is never inlined into the browser bundle.
# Dev-server only: it has no effect on `vite build` or on production.
DEV_API_PROXY=http://localhost:5001

# To override without editing this tracked file, create .env.development.local
# (gitignored) — NOT .env.local, which Vite ranks BELOW .env.development and
# which would therefore be silently ignored:
#
#   echo 'DEV_API_PROXY=https://your-app.vercel.app' > .env.development.local
#
# Pointing it at a deployed backend means local development reads and writes
# that backend's real database.

# The client needs nothing else: it calls a relative "/api", which the proxy
# above forwards in dev and Vercel routes to the Express function in prod.
#
# Only set this if the API lives on a different origin:
# VITE_API_URL=http://localhost:5001/api
