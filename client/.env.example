# Frontend environment variables (all optional).
#
# By default the client calls a relative "/api" path:
#   - dev:  vite.config.js proxies /api -> http://localhost:5001
#   - prod: the SPA and API share one Vercel origin
#
# Override this only when the backend runs on a different host/port.
# VITE_API_URL=http://localhost:5001/api
