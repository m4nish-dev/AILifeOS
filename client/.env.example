# Frontend environment variables — all optional.

# Dev-server proxy target for /api. Read by vite.config.js via loadEnv().
# Deliberately NOT VITE_-prefixed: build-time only, never reaches the
# browser bundle. Defaults to http://localhost:5001 when unset.
DEV_API_PROXY=http://localhost:5001

# Absolute API base URL used by the client at runtime.
# Leave unset in normal use: the app calls a relative "/api", which the dev
# proxy forwards locally and Vercel routes in production. Set it only when
# the backend is served from a different origin.
# VITE_API_URL=http://localhost:5001/api

# ── Vite .env precedence (highest last) ──────────────────────────
#   .env  <  .env.local  <  .env.[mode]  <  .env.[mode].local
# So a local dev override belongs in .env.development.local, not .env.local.
