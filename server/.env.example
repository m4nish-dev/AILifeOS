# ─────────────────────────────────────────────────────────────
# AILifeOS Backend — Environment Variables
# Copy this file to `.env` (which is gitignored) and fill in real values.
#   cp .env.example .env
# Do NOT commit your real .env file.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (required).
# Local example:  mongodb://127.0.0.1:27017/ailifeos
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ailifeos
MONGODB_URI=

# Secret used to sign JWT auth tokens (required).
# Use a long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long issued tokens stay valid (optional, defaults to 7d).
JWT_EXPIRES_IN=7d

# Groq API key, powers the AI features (optional).
# Without it the server still boots; AI endpoints return a clear config error.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Allowed browser origin(s) for CORS (optional).
# Only needed when the frontend is on a DIFFERENT domain from the API.
# Comma-separated list is supported, e.g.:
#   https://app.example.com,https://www.example.com
# Always allowed without listing: same-origin requests (frontend and API on one
# domain, as on Vercel or a single-server deploy), and any localhost port
# outside production.
CLIENT_URL=http://localhost:5173

# Port to listen on (optional, defaults to 5001). Hosts such as Render,
# Railway and Fly set this for you. Ignored on Vercel (serverless).
#
# Deployment modes:
#   Vercel         - repo-root vercel.json builds client + server together.
#   Single server  - `npm run build` then `NODE_ENV=production npm start` from
#                    the repo root; the API also serves client/dist.
#   Local dev      - `npm run dev` from the repo root.
PORT=5001
