# ─────────────────────────────────────────────────────────────
# AILifeOS Backend — Environment Variables
# Copy this file to `.env` (which is gitignored) and fill in real values.
#   cp .env.example .env
# Do NOT commit your real .env file.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (required).
# Local example:  mongodb://127.0.0.1:27017/ailifeos
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ailifeos
MONGODB_URI=

# Secret used to sign JWT auth tokens (required).
# Use a long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long issued tokens stay valid (optional, defaults to 7d).
JWT_EXPIRES_IN=7d

# Groq API key, powers the AI features (optional).
# Without it the server still boots; AI endpoints return a clear config error.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Allowed browser origin(s) for CORS (optional).
# Comma-separated list is supported, e.g.:
#   http://localhost:5173,https://your-app.vercel.app
# localhost:5173 and localhost:3000 are always allowed by default.
CLIENT_URL=http://localhost:5173

# Port for local development (optional, defaults to 5001).
# Ignored on Vercel, which runs the app as a serverless function.
PORT=5001
